{
  "name": "marzipano",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "plugins/*",
    "plugins/@greener-games/*"
  ],
  "scripts": {
    "dev": "vite",
    "build:app": "vue-tsc --noEmit && vite build",
    "build:workspaces": "npm run build --workspaces --if-present",
    "build": "npm run build:workspaces && npm run build:app",
    "preview": "vite preview"
  },
  "dependencies": {
    "@vueuse/core": "^10.7.2",
    "axios": "^1.7.9",
    "marzipano": "^0.10.2",
    "pathe": "^1.1.2",
    "vue": "^3.3.11",
    "vue-router": "^4.6.4"
  },
  "devDependencies": {
    "@greener-games/vue-marzipano": "*",
    "@microsoft/api-extractor": "^7.58.7",
    "@vitejs/plugin-vue": "^4.5.2",
    "@vue/tsconfig": "^0.7.0",
    "sass": "^1.69.7",
    "typescript": "^6.0.3",
    "vite": "^5.0.8",
    "vue-tsc": "^3.3.2"
  }
}
